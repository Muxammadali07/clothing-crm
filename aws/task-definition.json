{
  "family": "clothing-crm",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::338365424002:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::338365424002:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "clothing-crm",
      "image": "338365424002.dkr.ecr.us-east-1.amazonaws.com/clothing-crm:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT",     "value": "3000" }
      ],
      "secrets": [
        {
          "name": "MONGO_URI",
          "valueFrom": "arn:aws:ssm:us-east-1:338365424002:parameter/clothing-crm/MONGO_URI"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:338365424002:parameter/clothing-crm/JWT_SECRET"
        },
        {
          "name": "JWT_EXPIRES_IN",
          "valueFrom": "arn:aws:ssm:us-east-1:338365424002:parameter/clothing-crm/JWT_EXPIRES_IN"
        },
        {
          "name": "CLIENT_ORIGIN",
          "valueFrom": "arn:aws:ssm:us-east-1:338365424002:parameter/clothing-crm/CLIENT_ORIGIN"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/api/v1/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/clothing-crm",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
